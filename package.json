    "dev": "esbuild src/main.js --bundle --format=iife --outfile=game.bundle.js --watch"
  },
  "devDependencies": {
    "esbuild": "0.24.0",
    "three": "0.170.0",
    "cannon-es": "0.20.0"
  }
}
